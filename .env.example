# Dhan credentials — fill these in a copy named ".env" (never commit .env)
# You have these four:
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_24hr_access_token_here
DHAN_API_KEY=your_api_key_here
DHAN_API_SECRET=your_api_secret_here

# You do NOT have these (headless auto-token). Leave blank — manual token path is used.
DHAN_TOTP_SECRET=
DHAN_PIN=